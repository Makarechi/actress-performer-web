---
import "../styles/global.css";
import { withBase } from "@data/paths";
import { profile } from "@data/profile";
import { localeNames, publicLocales } from "@data/i18n";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, follow" />
    <title>{profile.name} — Choose Language</title>
    <meta http-equiv="refresh" content={`2; url=${withBase("/en/")}`} />
  </head>
  <body>
    <main class="language-gate">
      <h1>{profile.name}</h1>
      <p>Choose a language</p>
      <div>
        {publicLocales.map((locale) => <a href={withBase(`/${locale}/`)}>{localeNames[locale]}</a>)}
      </div>
    </main>
  </body>
</html>
