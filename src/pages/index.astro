---
import "../styles/global.css";
import WasmApp from "@components/WasmApp.astro";
import { withBase } from "@data/paths";
import { profile } from "@data/profile";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, follow" />
    <title>{profile.name} — Choose Language</title>
    <meta http-equiv="refresh" content={`2; url=${withBase("/en/")}`} />
  </head>
  <body>
    <WasmApp page="gate" locale="en" />
  </body>
</html>
