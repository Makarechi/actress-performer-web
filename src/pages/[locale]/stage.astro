---
import StagePage from "@components/StagePage.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { locales, normalizeLocale, publicLocales } from "@data/i18n";
import { stageCopy } from "@data/stage";

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = normalizeLocale(Astro.params.locale);
const copy = stageCopy[locale];
const isPublicLocale = publicLocales.includes(locale);
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  locale={locale}
  canonicalPath={`/${locale}/stage/`}
  robots={isPublicLocale ? undefined : "noindex, follow"}
>
  <StagePage locale={locale} />
</BaseLayout>
