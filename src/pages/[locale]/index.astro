---
import WasmApp from "@components/WasmApp.astro";
import HomePage from "@components/HomePage.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { locales, normalizeLocale, translations } from "@data/i18n";

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = normalizeLocale(Astro.params.locale);
const t = translations[locale];
const isCommercialLocale = locale === "en" || locale === "sk";
---

<BaseLayout title={t.siteTitle} description={t.siteDescription} locale={locale} canonicalPath={`/${locale}/`}>
  {isCommercialLocale ? <HomePage locale={locale} /> : <WasmApp page="home" locale={locale} />}
</BaseLayout>
