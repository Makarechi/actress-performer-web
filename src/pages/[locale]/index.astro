---
import WasmApp from "@components/WasmApp.astro";
import HomePage from "@components/HomePage.astro";
import UkrainianHomePage from "@components/UkrainianHomePage.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { locales, normalizeLocale, publicLocales, translations } from "@data/i18n";

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = normalizeLocale(Astro.params.locale);
const t = translations[locale];
const isCommercialLocale = locale === "en" || locale === "sk";
const isUkrainianLocale = locale === "uk";
const isPublicLocale = publicLocales.includes(locale);
---

<BaseLayout
  title={t.siteTitle}
  description={t.siteDescription}
  locale={locale}
  canonicalPath={`/${locale}/`}
  robots={isPublicLocale ? undefined : "noindex, follow"}
>
  {isCommercialLocale ? <HomePage locale={locale} /> : isUkrainianLocale ? <UkrainianHomePage /> : <WasmApp page="home" locale={locale} />}
</BaseLayout>
