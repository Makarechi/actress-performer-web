---
import WasmApp from "@components/WasmApp.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { locales, normalizeLocale, translations } from "@data/i18n";

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = normalizeLocale(Astro.params.locale);
const t = translations[locale];
---

<BaseLayout title={t.siteTitle} description={t.siteDescription} locale={locale} canonicalPath={`/${locale}/`}>
  <WasmApp page="home" locale={locale} />
</BaseLayout>
