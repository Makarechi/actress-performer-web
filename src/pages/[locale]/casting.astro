---
import CastingPage from "@components/CastingPage.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { locales, normalizeLocale, publicLocales, translations } from "@data/i18n";

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = normalizeLocale(Astro.params.locale);
const t = translations[locale];
const isPublicLocale = publicLocales.includes(locale);
---

<BaseLayout
  title={t.casting.title}
  description={t.casting.description}
  locale={locale}
  canonicalPath={`/${locale}/casting/`}
  robots={isPublicLocale ? undefined : "noindex, follow"}
>
  <CastingPage locale={locale} />
</BaseLayout>
