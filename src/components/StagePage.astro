---
import SiteFooter from "@components/SiteFooter.astro";
import SiteHeader from "@components/SiteHeader.astro";
import { getCommercialLocale, mailtoHref, siteCopy } from "@data/commercial";
import { getLocalizedInstagramPosts, translations, type Locale } from "@data/i18n";
import { localeVisuals } from "@data/localeVisuals";
import { withBase } from "@data/paths";
import { profile } from "@data/profile";
import { stageCopy } from "@data/stage";
import { aerialGymnasticsMedia, ukrainianVocalPerformanceMedia } from "@data/specialMedia";

type Props = {
  locale: Locale;
};

const { locale } = Astro.props;
const copy = stageCopy[locale];
const visual = localeVisuals[locale];
const t = translations[locale];
const commercialLocale = getCommercialLocale(locale);
const commercialCopy = siteCopy[commercialLocale];
const localizedPath = (path: string) => withBase(`/${locale}${path}`);
const localizedCommercialPath = (path: string) => withBase(`/${commercialLocale}${path}`);
const castingRequest = commercialCopy.contact.topics[0];
const contactHref = mailtoHref(castingRequest[1], `Hello Taisija,\n\n${castingRequest[2]}`);
const stagePosts = getLocalizedInstagramPosts(locale).filter((post) =>
  ["theatre-day", "little-women-stage", "vocal-concert", "hosting-st-nicholas"].includes(post.id)
);
const proofCopy =
  commercialLocale === "sk"
    ? {
        eyebrow: "Dostupné materiály",
        title: "Pohyb, hlas a hudba nemusia čakať na experimentálny režim.",
        body: "Stage stránka teraz funguje aj bez JavaScriptu: ukazuje fyzické skills, live performance a priame cesty na casting a kontakt.",
        aerial: "Aerial gymnastics",
        aerialBody: "Movement material for stage, camera and special-skills casting.",
        music: "Ukrainian vocal performance",
        musicBody: "Live music proof for cultural events, stage work and performance formats."
      }
    : {
        eyebrow: "Available proof",
        title: "Movement, voice and music are visible without the experimental layer.",
        body: "The Stage page now works without JavaScript: it shows physical skills, live performance and direct paths to casting and contact.",
        aerial: "Aerial gymnastics",
        aerialBody: "Movement material for stage, camera and special-skills casting.",
        music: "Ukrainian vocal performance",
        musicBody: "Live music proof for cultural events, stage work and performance formats."
      };
---

<SiteHeader locale={locale} active="stage" />

<main class={`stage-experience stage-${visual.theme}`}>
  <section class="stage-hero" data-stage-theme={visual.theme}>
    <div class="stage-hero-copy">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1>{copy.headline}</h1>
      <p>{copy.body}</p>
      <div class="hero-actions">
        <a class="button primary" href={localizedPath("/casting/")}>{copy.enterCasting}</a>
        <a class="button secondary" href={localizedCommercialPath("/events-hosting/")}>{commercialCopy.nav.events}</a>
        <a class="button secondary" href={contactHref}>{commercialCopy.nav.contact}</a>
      </div>
    </div>
    <div class="stage-portrait">
      <img src={profile.headshot} alt={`Portrait of ${profile.name}`} width="1080" height="1080" />
      <span>{profile.name}</span>
    </div>
  </section>

  <section class="section locale-visual-plan">
    <div class="section-heading">
      <p class="eyebrow">{visual.eyebrow}</p>
      <h2>{visual.title}</h2>
      <p>{visual.body}</p>
    </div>
    <div class="visual-plan-layout">
      <article class="visual-backdrop-card">
        <p class="eyebrow">Stage direction</p>
        <h3>{visual.backdrop}</h3>
      </article>
      <div class="visual-media-list">
        {visual.media.map((item) => (
          <article>
            <span aria-hidden="true"></span>
            <p>{item}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section stage-proof-section">
    <div class="section-heading">
      <p class="eyebrow">{proofCopy.eyebrow}</p>
      <h2>{proofCopy.title}</h2>
      <p>{proofCopy.body}</p>
    </div>
    <div class="stage-proof-grid">
      <article class="stage-media-card">
        <video controls preload="metadata" poster={aerialGymnasticsMedia.poster}>
          <source src={aerialGymnasticsMedia.highlight} type="video/mp4" />
        </video>
        <div>
          <p class="eyebrow">Movement</p>
          <h3>{proofCopy.aerial}</h3>
          <p>{proofCopy.aerialBody}</p>
        </div>
      </article>
      <article class="stage-media-card">
        <video controls preload="metadata" poster={ukrainianVocalPerformanceMedia.poster}>
          <source src={ukrainianVocalPerformanceMedia.src} type="video/mp4" />
        </video>
        <div>
          <p class="eyebrow">Music</p>
          <h3>{proofCopy.music}</h3>
          <p>{proofCopy.musicBody}</p>
        </div>
      </article>
    </div>
  </section>

  <section class="section stage-mode-map">
    <div class="section-heading">
      <p class="eyebrow">{copy.current.eyebrow}</p>
      <h2>{copy.current.title}</h2>
      <p>{copy.current.body}</p>
    </div>
    <div class="mode-grid">
      {copy.modes.map(([title, body], index) => (
        <article>
          <span>{String(index + 1).padStart(2, "0")}</span>
          <div>
            <h3>{title}</h3>
            <p>{body}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section stage-moments">
    <div class="section-heading">
      <p class="eyebrow">Creative plan</p>
      <h2>Scene chapters for future media.</h2>
    </div>
    <div class="stage-moment-grid">
      {copy.moments.map(([title, body]) => (
        <article>
          <h3>{title}</h3>
          <p>{body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section dark-band">
    <div class="section-heading">
      <p class="eyebrow">{t.selected.eyebrow}</p>
      <h2>{t.selected.title}</h2>
      <p>{t.selected.body}</p>
    </div>
    <div class="instagram-grid compact-cards">
      {stagePosts.map((post) => (
        <article class="instagram-card">
          <a href={post.href} target="_blank" rel="noreferrer">
            <img src={post.image} alt={post.alt} loading="lazy" width="800" height="1000" />
            <div>
              <p class="eyebrow">{post.category}</p>
              <h3>{post.title}</h3>
              <p>{post.note}</p>
            </div>
          </a>
        </article>
      ))}
    </div>
  </section>
</main>

<SiteFooter locale={locale} />
